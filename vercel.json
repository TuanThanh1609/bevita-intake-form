{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/embed",
      "destination": "/api/embed.js"
    },
    {
      "source": "/api/crm/leads",
      "destination": "/api/crm.js"
    },
    {
      "source": "/api/inbox",
      "destination": "/api/inbox.js"
    },
    {
      "source": "/api/phacdo",
      "destination": "/api/phacdo.js"
    }
  ]
}
